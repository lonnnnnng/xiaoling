<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.XiaoLing" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/window_background_xiaoling</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F8FAFC</item>
        <item name="android:statusBarColor">#F8FAFC</item>
        <!-- long: Android 12+ 必然存在系统启动画面；背景与窗口背景同色、图标全透明且不设置图标底色，使启动画面在视觉上不可见。 -->
        <item name="android:windowSplashScreenBackground">@color/xiaoling_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_xiaoling_splash_transparent</item>
    </style>
</resources>
